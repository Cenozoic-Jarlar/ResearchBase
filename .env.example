# ============================================================
# ResearchBase 环境变量模板
#
# 用法：复制本文件为 .env 并填写真实密钥
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# 注意：
#   - .env 已被 .gitignore 排除，真实密钥永不入库
#   - 模型档位 / 价格 / base_url 等基础设施配置在 manual_settings.py（可入库）
#   - 每个档位用 resolve_key("LLM_<档位大写>_API_KEY") 显式声明密钥变量；
#     未配置的档位在调用时会报清晰错误（提示去 .env 加变量），不静默错用其他提供商的 key
# ============================================================

# ---------- 大模型 API（OpenAI 兼容） ----------
# 全局密钥与地址：router/standard 档默认用这里（当前示例=硅基流动）
LLM_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.siliconflow.cn/v1

# 可选：某档位专属密钥（档位名大写），例如推理档 reasoning（DeepSeek 官方）
# 填了就启用 reasoning 档；留空=调用 reasoning 档时报"未配置"错误
# LLM_REASONING_API_KEY=sk-你的DeepSeek官方key
# LLM_REASONING_BASE_URL=https://api.deepseek.com/v1

# 其他提供商示例（OpenAI）：
# LLM_OPENAI_API_KEY=sk-你的OpenAI官方key
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 运行端口 ----------
# Web GUI 端口（默认 5178）
# GUI_PORT=5178
# 资源浏览器独立端口（默认 5179）
# RES_PORT=5179

# ---------- 命令行任务级覆盖 ----------
# 非交互指定主题域（默认=通用层，也可在 main.py 交互输入）
# DOMAIN=工作A
# 任务级强制模型档位：router / standard / reasoning
# MODEL_TIER=reasoning
# 显式指定价值观框架（逗号分隔，可叠加）
# PROFILES=cute_style,policy

# ---------- 运行参数（可选；默认值见 manual_settings.py） ----------
# 详细日志开关（true/false；默认 true）
# DETAIL_LOG_ENABLED=true
# LLM 调用超时（秒；默认 90）
# LLM_TIMEOUT=90
# LLM 失败重试次数（默认 1）
# LLM_MAX_RETRIES=1
# 价格兜底（元/百万 tokens；当某档位未配置价格时使用）
# LLM_PRICE_INPUT=2
# LLM_PRICE_OUTPUT=8
# 日志保留天数（默认 30；启动时自动清理超过 N 天的日志；0=不清理）
# LOG_RETENTION_DAYS=30
